# Ignore data and large files
data/
*.csv
*.parquet
*.json

# Ignore heavy ML model files
outputs/*.pkl
outputs/*.joblib

# Ignore the local activity-log database (runtime state, not source data)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Ignore Python cache and environments
__pycache__/
*.pyc
.env
.venv/
venv/
env/

# Ignore OS generated files
.DS_Store
